# ════════════════════════════════════════════════════════════
# video-x-bot — config template
# ════════════════════════════════════════════════════════════
# 1. Copy file này:  cp .env.example .env
# 2. Điền các giá trị có dấu < > (token, key, profile id).
# 3. Restart:  docker compose up -d --force-recreate
#
# FLOW chính:
#   Cron 08/14/20h VN → auto-crawl TikTok+YouTube (anime + life hack)
#   → strip audio + mix nhạc no-copyright → launder → caption EN hot-take
#   → review card về Telegram → bạn /approve
#   → slot 14:00 / 19:00 / 01:00 VN → GPM Login post X + YouTube Shorts
# ────────────────────────────────────────────────────────────

# ─────────────────────── App ────────────────────────────────
APP_NAME=video-x-bot
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# ─────────────────── Telegram bot ───────────────────────────
# Token từ @BotFather. allowed_user_ids từ @userinfobot (comma list).
# Webhook bỏ trống = polling mode (đơn giản hơn).
TELEGRAM_BOT_TOKEN=<bot-token>
TELEGRAM_ALLOWED_USER_IDS=<your-user-id>
TELEGRAM_WEBHOOK_URL=

# ──────────────── DeepSeek (caption LLM) ────────────────────
# Sinh caption hot-take EN. Hết quota → fallback rule-based.
DEEPSEEK_API_KEY=<deepseek-api-key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ──────────── X (Twitter) — qua GPM Login ──────────────────
# Worker Docker → host.docker.internal. Worker native Win → 127.0.0.1.
GPM_API_BASE=http://host.docker.internal:19995
GPM_PROFILE_ID=<gpm-profile-id>     # vd: P-20250610-0247
GPM_CLOSE_AFTER_POST=true
GPM_POST_TIMEOUT_SEC=120
GPM_LOCK_TTL_SEC=600
GPM_LOCK_WAIT_SEC=900

PUBLISH_TO_X=true

# ─────────────── YouTube Shorts (optional) ──────────────────
# OAuth bootstrap 1 lần: scripts/yt_oauth_bootstrap.py
YOUTUBE_ENABLED=false
PUBLISH_TO_YOUTUBE=false
YOUTUBE_CREDENTIALS_PATH=/app/secrets/yt_credentials.json
YOUTUBE_TOKEN_PATH=/app/secrets/yt_token.json
YOUTUBE_CATEGORY_ID=1               # 1=Film&Anim, 24=Entertainment, 28=Sci/Tech
YOUTUBE_PRIVACY=public              # public | unlisted | private
YOUTUBE_DEFAULT_TAGS=shorts,anime,animeedit,lifehack,satisfying,viral

# ─────────────── Facebook Page (optional) ───────────────────
# Lấy Page Access Token (long-lived) từ Graph API Explorer
# với quyền: pages_manage_posts, pages_read_engagement
PUBLISH_TO_FACEBOOK=false
FACEBOOK_PAGE_ID=<your-page-id>
FACEBOOK_PAGE_ACCESS_TOKEN=<your-page-access-token>

# ──────────────────── Persistence ───────────────────────────
DATABASE_URL=sqlite:///./storage/app.db
REDIS_URL=redis://redis:6379/0

# ─────────────────── Storage paths ──────────────────────────
STORAGE_ROOT=./storage
RAW_VIDEO_DIR=./storage/raw
AUDIO_DIR=./storage/audio
TRANSCRIPT_DIR=./storage/transcript
SUBTITLE_DIR=./storage/subtitle
OUTPUT_VIDEO_DIR=./storage/output
LOG_DIR=./storage/logs

# ───────── Disk cleanup (daily 04:30 UTC = 11:30 VN) ───────
RETENTION_DAYS_POSTED=7             # job posted >N → archive (xoá file, giữ DB)
RETENTION_DAYS_FAILED=14            # failed/expired/rejected/archived >N → xoá DB
STORAGE_MAX_GB=20                   # vượt → evict file cũ nhất

# ─────────────────── Lịch post X+YT ─────────────────────────
# 3 slot/ngày trong window 13h-02h VN. dispatch_due_slots (5p/lần)
# kích publish khi tới giờ. Format: HH:MM,HH:MM,...
POST_SLOTS_VN=14:00,19:00,01:00

# ─────────────── Pipeline behavior toggles ──────────────────
ENABLE_AUTO_TRANSLATE_TO_EN=true
ENABLE_SEND_PREVIEW_TO_TELEGRAM=true
REQUIRE_APPROVAL_BEFORE_POST=true   # true = chờ /approve, false = post tự động
ENABLE_AUTO_POST=false              # cùng flag với /autopost on|off (live toggle)
STRIP_AUDIO_FOR_MANUAL=true         # /add cũng xoá audio gốc + mix nhạc

# ──────── Caption / Locale (kênh global single channel) ────
DEFAULT_CAPTION_STYLE=public_clean
DEFAULT_OUTPUT_LANGUAGE=en
DEFAULT_PROFILE_CODE=A1
PROFILE_TIMEZONE=Asia/Ho_Chi_Minh
PROFILE_HOURLY_MAP=A1,A1,A1,A1,A1,A1,A1,A1,A1,A1,A1,A1,A1,A1,A1,A1,A1,A1,A1,A1,A1,A1,A1,A1
# CAPTION_PROFILES_JSON=            # JSON override 4 profile (mặc định en/ja/ko/zh)

# ──────────────── External binaries ─────────────────────────
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
YTDLP_BIN=yt-dlp

# ──────────── Cookies cho yt-dlp (manual /add) ──────────────
# Paste full Cookie từ DevTools nếu link bị anti-bot.
YTDLP_COOKIE_FILE=
YTDLP_COOKIES_FROM_BROWSER=         # firefox|chrome|edge
YTDLP_BROWSER_PROFILE=
INSTAGRAM_COOKIE_HEADER=
FACEBOOK_COOKIE_HEADER=
TIKTOK_COOKIE_HEADER=

# ─────── Limits download (pre-check trước khi tải) ─────────
MAX_VIDEO_DURATION_SECONDS=300
MAX_VIDEO_FILE_SIZE_MB=200
DOWNLOAD_TIMEOUT_SECONDS=180

# ───────────── Auto-crawl (TikTok + YouTube) ────────────────
# Beat: 08h/14h/20h VN. Scope mặc định: anime + life hack.
AUTO_CRAWL_ENABLED=false
CRAWL_MAX_CANDIDATES=50
CRAWL_MIN_DURATION_SEC=15
CRAWL_MAX_DURATION_SEC=90

REVIEW_TIMEOUT_HOURS=12

TIKTOK_HASHTAG_URLS=https://www.tiktok.com/tag/anime,https://www.tiktok.com/tag/animeedit,https://www.tiktok.com/tag/lifehack,https://www.tiktok.com/tag/oddlysatisfying

YOUTUBE_SEARCH_QUERIES=anime edit shorts no subtitle,anime amv shorts raw,life hack shorts no talking,oddly satisfying shorts no sub
YOUTUBE_HASHTAG_URLS=
YOUTUBE_EXCLUDE_UPLOADERS=

SILENT_KEYWORDS_POSITIVE=anime,animation,amv,anime edit,manga,aesthetic,life hack,lifehack,hack,kitchen hack,diy,satisfying,oddly satisfying,clever,trick,no sub,no subtitle,raw,no voice,no talking,silent
SILENT_KEYWORDS_NEGATIVE=subtitle,subtitles,subs,vietsub,engsub,eng sub,sub indo,字幕,中字,翻译,dubbed,dub,tutorial,vlog,reaction,review,interview,podcast,commentary,storytime

# ────── Audio replacer (mix nhạc no-copyright) ─────────────
# Folder: ./assets/music/{chill,cute,cinematic,viral}/*.mp3
# Lấy nhạc:  python scripts/fetch_music.py --source mixkit --mood all
AUDIO_REPLACE_ENABLED=true
MUSIC_LIBRARY_DIR=./assets/music
MUSIC_DEFAULT_MOOD=cinematic
MUSIC_VOLUME=0.85
MUSIC_FADE_IN_SEC=1.0
MUSIC_FADE_OUT_SEC=1.5
MUSIC_LOOP_IF_SHORTER=true

# ──────── Content Laundering (anti-fingerprint) ────────────
# Output 9:16 1080×1920. Mặc định OK, chỉ đổi nếu cần fine-tune.
ENABLE_LAUNDER=true
LAUNDER_TARGET_W=1080
LAUNDER_TARGET_H=1920
LAUNDER_BLUR_STRENGTH=25
LAUNDER_BLUR_PASSES=5
LAUNDER_FG_SCALE_PORTRAIT=0.90
LAUNDER_LANDSCAPE_THRESHOLD=1.3
LAUNDER_PITCH_SHIFT=1.04            # +4% pitch
LAUNDER_TOTAL_TEMPO=1.15            # nhanh 15%
LAUNDER_EQ_FREQ=1500
LAUNDER_EQ_GAIN=-2.0
LAUNDER_EQ_WIDTH=1.0
LAUNDER_ECHO_IN_GAIN=0.8
LAUNDER_ECHO_OUT_GAIN=0.9
LAUNDER_ECHO_DELAY_MS=40
LAUNDER_ECHO_DECAY=0.10
LAUNDER_NOISE_PATH=assets/noise/rain.mp3
LAUNDER_NOISE_VOLUME=0.15
LAUNDER_CRF=24
LAUNDER_MAXRATE_KBPS=8000
LAUNDER_PRESET=medium
LAUNDER_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# Watermark góc dưới phải. Trống = không watermark.
LAUNDER_WATERMARK_TEXT=
LAUNDER_WATERMARK_OPACITY=0.55
LAUNDER_TITLE_MAX_WORDS=10
LAUNDER_TITLE_MAX_CHARS=22
# Cắt N giây cuối output (bỏ end-card creator gốc). 0 = không trim.
LAUNDER_TRIM_END_SEC=0
